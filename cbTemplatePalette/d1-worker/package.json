{
  "name": "cb-template-palette-d1",
  "version": "1.0.0",
  "private": true,
  "description": "テンプレパレットくんの共有カテゴリを Cloudflare D1 に置くための Worker（各自・チームでデプロイする）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply cb-template-palette --remote",
    "migrate:local": "wrangler d1 migrations apply cb-template-palette --local",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.0.0"
  }
}
