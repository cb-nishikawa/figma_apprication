{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "typeRoots": ["./node_modules/@types", "./node_modules/@figma"]
  },
  "include": [
    "src/code.ts",
    "src/serialize.ts",
    "src/deserialize.ts",
    "src/storage.ts",
    "src/storageAdapter.ts",
    "src/jsonCodec.ts",
    "src/d1Storage.ts",
    "src/dropboxAuth.ts",
    "src/dropboxSession.ts",
    "src/dropboxStorage.ts",
    "src/sources.ts",
    "src/linkedCategories.ts",
    "src/stores.ts",
    "src/types.ts",
    "src/tree.ts",
    "src/messages.ts",
    "src/global.d.ts"
  ]
}
