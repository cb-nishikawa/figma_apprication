{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "typeRoots": ["./node_modules/@types", "./node_modules/@figma"]
  },
  "include": [
    "src/code.ts",
    "src/search.ts",
    "src/types.ts",
    "src/messages.ts",
    "src/highlight.ts",
    "src/highlightRanges.ts",
    "src/pinTargets.ts",
    "src/global.d.ts",
    "tests/**/*.ts"
  ]
}

