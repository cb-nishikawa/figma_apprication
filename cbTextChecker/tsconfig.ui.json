{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/ui.ts",
    "src/types.ts",
    "src/messages.ts",
    "src/search.ts",
    "src/compare.ts",
    "src/ocr/**/*.ts",
    "src/global.d.ts"
  ]
}
